%%   \caption{...}\label{fig:...}\end{figure}

%% ---------- 8. 时间线宏（史料章节常用） ----------
%% \tl{1962}{巴赫金《拉伯雷》法译本问世}
\newcommand{\tl}[2]{\par\noindent\hangindent=3.6em\hangafter=1
  {\heiti\color{NLDeep}#1}\hspace{0.5em}#2\par\vspace{0.15em}}

%% ---------- 9. 习题区 ----------
\newenvironment{nlexercises}[1][本章习题]{%
  \par\medskip\noindent{\heiti\fontsize{13.5}{16}\selectfont\color{NLDeep}#1}\par
  \vspace{0.3em}
  \begin{enumerate}[label=\arabic*.,leftmargin=2.2em,itemsep=0.25em,topsep=0.2em]
}{%
  \end{enumerate}
}
\newenvironment{nlkeywords}[1][关键术语]{%
  \par\medskip\noindent{\heiti\color{NLDeep}#1：}\hspace{0.2em}
}{\par}

